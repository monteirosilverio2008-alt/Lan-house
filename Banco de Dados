CREATE TABLE clientes(
	id_cliente INT PRIMARY KEY NOT NULL,
	nome VARCHAR(500) NOT NULL,
	data_nace DATE NOT NULL

);

CREATE TABLE contrato_c(
	id_contato_c INT PRIMARY KEY NOT NULL,
	tipo_contato VARCHAR (20) NOT NULL,
	contato VARCHAR (500) NOT NULL,
	id_cliente INT NOT NULL,
	FOREIGN KEY (id_cliente) REFERENCES clientes(id_cliente)
);

CREATE TABLE funsionarios(
	id_funsionario INT PRIMARY KEY NOT NULL,
	nome VARCHAR (500) NOT NULL,
	funcao_cago VARCHAR (100) NOT NULL
);

CREATE TABLE contrato_f(
	id_contato_f INT PRIMARY KEY NOT NULL,
	tipo_contato VARCHAR (20) NOT NULL,
	contato VARCHAR(500) NOT NULL,
	id_funsionario INT  NOT NULL,
	FOREIGN KEY (id_funsionario) REFERENCES funsionarios(id_funsionario)
);

CREATE TABLE mouses(
	id_mouse INT PRIMARY KEY NOT NULL,
	marca VARCHAR (50) NOT NULL,
	modelo VARCHAR (100) NOT NULL,
	hz INT NOT NULL	
);

CREATE TABLE teclados(
	id_teclado INT PRIMARY KEY NOT NULL,
	marca VARCHAR(100) NOT NULL,
	modelo VARCHAR(50) NOT NULL,
	tipo_taclado VARCHAR (10) NOT NULL
);

CREATE TABLE monitores(
	id_monitor INT PRIMARY KEY NOT NULL,
	marca VARCHAR (50) NOT NULL,
	tamanho_tela FLOAT NOT NULL,
	hz INT NOT NULL
);

CREATE TABLE gabinetes(
	id_gabinete INT PRIMARY KEY NOT NULL,
	processado VARCHAR (100) NOT NULL,
	placa_mae VARCHAR (100),
	memoria_ram INT NOT NULL
);

CREATE TABLE computadores(
	id_computado INT PRIMARY KEY NOT NULL,
	stato VARCHAR NOT NULL,
	valor FLOAT NOT NULL,
	id_mouse INT NOT NULL,
	id_teclado INT NOT NULL,
	id_monitor INT NOT NULL,
	id_gabinete INT  NOT NULL
);
CREATE TABLE patrocinadores(
	id_patrocinadore INT PRIMARY KEY NOT NULL,
	empresa VARCHAR (100) NOT NULL
);
CREATE TABLE competicao(
	id_competicao INT PRIMARY KEY NOT NULL,
	valor_incricoa FLOAT NOT NULL,
	premiacao VARCHAR(200) NOT NULL,
	tipo VARCHAR NOT  NULL,
	jogo VARCHAR
);
CREATE TABLE equipes(
	id_equipe INT PRIMARY KEY NOT NULL,
	numero_mebros INT NOT NULL,
	nome VARCHAR(100) NOT NULL
);
CREATE TABLE competicao_patrocinadores(
	id_competicao INT NOT NULL,
	id_patrocinadore INT NOT NULL,
	valor_doado FLOAT NOT NULL,
	
	PRIMARY KEY(id_competicao, id_patrocinadore),
	FOREIGN KEY (id_competicao) REFERENCES competicao(id_competicao),
	FOREIGN KEY (id_patrocinadore) REFERENCES patrocinadores(id_patrocinadore)
);
CREATE TABLE equipes_clientes(
	id_cliente INT NOT NULL,
	id_equipe INT NOT NULL,
	cargo VARCHAR (50) NOT NULL,
	
	PRIMARY KEY(id_cliente, id_equipe),
	FOREIGN KEY (id_cliente) REFERENCES clientes(id_cliente),
	FOREIGN KEY (id_equipe) REFERENCES equipes(id_equipe)
);
CREATE TABLE equipes_competicao(
	id_equipe INT NOT NULL,
	id_competicao INT NOT NULL,
	
	PRIMARY KEY (id_competicao, id_equipe),
	FOREIGN KEY (id_equipe) REFERENCES equipes(id_equipe),
	FOREIGN KEY (id_competicao) REFERENCES competicao(id_competicao)
);
CREATE TABLE aluguel (
	id_aluguel INT PRIMARY KEY NOT NULL,
	hora_inicio VARCHAR(10) NOT NULL,
	hora_fim VARCHAR(10) NOT NULL,
	id_computado INT NOT NULL,
	id_funsionario INT NOT NULL,
	id_cliente INT NOT NULL,

	FOREIGN KEY (id_computado) REFERENCES computadores(id_computado),
	FOREIGN KEY (id_funsionario) REFERENCES funsionarios(id_funsionario),
	FOREIGN KEY (id_cliente) REFERENCES clientes(id_cliente)
);

